# PF_login real-provider proof environment template
# Fill values only in your local .env or shell. Do not commit filled values.
# This template intentionally contains no Apple IDs, passwords, cookies, tokens, API keys, or provider secrets.

# --- Real geocode provider proof ---
PF_PROOF_ENABLE_REAL_GEOCODE_CHAIN=false
PF_GEOCODE_CHAIN_PROOF_PROVIDER=nominatim_osm
# Optional proof fixture overrides:
# PF_GEOCODE_CHAIN_FIXTURE_NAME=tallinn_known_point
# PF_GEOCODE_CHAIN_PROOF_LATITUDE=59.437
# PF_GEOCODE_CHAIN_PROOF_LONGITUDE=24.7536
# PF_GEOCODE_CHAIN_PROOF_LANGUAGE=en
# PF_GEOCODE_CHAIN_EXPECTED_TERMS=Tallinn;Estonia

# --- Real iCloudPD proof ---
PF_PROOF_ENABLE_REAL_ICLOUDPD=false
# Configure these only in local/private environment, never in proof artifacts:
# user=
# pw=
# ICLOUDPD_COOKIE_DIR=runtime_data/icloudpd_cookies

# --- Real repeated-download continuation proof ---
PF_PROOF_ENABLE_REAL_DOWNLOAD_CONTINUATION=false
# Optional explicit directory. If unset, proof uses backend verify-env DOWNLOAD_DIR when available.
# PF_REAL_DOWNLOAD_PROOF_DOWNLOAD_DIR=runtime_data/downloads
# PF_REAL_DOWNLOAD_PROOF_RECENT_COUNT=10

# --- Backend base URL for live route proofs ---
PF_API_BASE_URL=http://127.0.0.1:8787
