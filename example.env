user=a.b@c.com
pw=xxx69

DOWNLOAD_DIR=runtime_data/downloads
DB_PATH=runtime_data/photo_frame.sqlite
TEST_DB_PATH=test_runtime_data/test_photo_frame.sqlite
TEST_DOWNLOAD_DIR=test_runtime_data/downloads
TEST_LOG_DIR=test_runtime_data/logs
TEST_FULL_LOG=test_runtime_data/logs/full_log.log
LOG_DIR=runtime_data/logs
ICLOUDPD_COOKIE_DIR=runtime_data/icloudpd_cookies

# Project logs are written under LOG_DIR as error.log, debug.log, log_<datetime>.log, and full_log.log.
# FULL_LOG_VERBOSE=true also writes sanitized request/response lifecycle JSONL to full_log_verbose.log.
FULL_LOG=runtime_data/logs/full_log.log
FULL_LOG_VERBOSE=true
CLEAR_FULL_LOG=AFTER_100MB

# Enabled for the current login-debugging baseline. Raw iCloudPD stdout/stderr is written only
# under runtime_data/private_logs and is never returned by API/UI/event history.
ICLOUDPD_RAW_STDIO_LOG=1
ICLOUDPD_RAW_STDIO_LOG_PATH=runtime_data/private_logs/icloudpd_raw_stdio.log


DOWNLOAD_RECENT=25
GEOCODE_LANGUAGE=en
GEOCODE_BATCH_SIZE=35
GEONAMES_USERNAME=

LOCK_TIMEOUT_SECONDS=60

REGULAR_WORKER_STALE_SECONDS=900
PLAYBACK_WORKER_STALE_SECONDS=30
REGULAR_WORKER_HEARTBEAT_SECONDS=5
PLAYBACK_WORKER_HEARTBEAT_SECONDS=5
WORKER_LOCK_RECLAIM_CONFLICT_THRESHOLD=3
REGULAR_WORKER_FORCE_RECLAIM_AFTER_SECONDS=1800
PLAYBACK_WORKER_FORCE_RECLAIM_AFTER_SECONDS=30

GEOCODE_CACHE_KEY_DECIMALS=5
UNRESOLVED_ASSET_POLICY=skip
PLAYBACK_RESTART_POLICY=fairness
VIDEO_SHOWN_POLICY=on_select
CLEANUP_ENABLED=false
MEDIA_RETENTION_DAYS=30
LOG_RETENTION_DAYS=30
PLAYBACK_LEASE_SECONDS=45


# Native OS playback runner. Disabled by default so browser playback and Test Mode stay safe.
#
# Local Windows fullscreen playback enablement example, based on repo-local mpv:
#   NATIVE_PLAYBACK_ENABLED=true
#   NATIVE_PLAYBACK_PLATFORM=windows
#   NATIVE_PLAYBACK_PLAYER=mpv
#   NATIVE_PLAYBACK_PLAYER_PATH=S:\PF_login\tools\mpv\windows\mpv.exe
#   NATIVE_PLAYBACK_FULLSCREEN=true
#   NATIVE_PLAYBACK_REPLACE_EXISTING=true
#   NATIVE_PLAYBACK_IMAGE_DURATION_SECONDS=12
#   NATIVE_PLAYBACK_AUTO_START_ON_WORKER=false
#
# Keep AUTO_START_ON_WORKER=false until manual Start native fullscreen has been tested.
NATIVE_PLAYBACK_ENABLED=false
NATIVE_PLAYBACK_PLATFORM=auto
NATIVE_PLAYBACK_PLAYER=mpv
NATIVE_PLAYBACK_PLAYER_PATH=
NATIVE_PLAYBACK_FULLSCREEN=true
NATIVE_PLAYBACK_REPLACE_EXISTING=true
NATIVE_PLAYBACK_IMAGE_DURATION_SECONDS=12
NATIVE_PLAYBACK_AUTO_START_ON_WORKER=false

# Reverse-geocoding provider chain. Address cache is always first; network providers are
# registered but disabled by default so enabling real providers is explicit.
GEOCODE_PROVIDER_ORDER=address_cache,nominatim_osm,photon_komoot,postcodes_io_uk,pelias_self_hosted,opencage,geoapify,mapbox,google_geocoding,deterministic_placeholder
GEOCODE_NETWORK_PROVIDERS_ENABLED=false
GEOCODE_ALLOW_NETWORK_PROVIDERS=false
GEOCODE_ALLOW_PLACEHOLDER_FALLBACK=true

# Standardized account/config fields for every geocoding provider:
# GEOCODE_<PROVIDER_ID>_ENABLED=true|false
# GEOCODE_<PROVIDER_ID>_ACCOUNT_USERNAME=
# GEOCODE_<PROVIDER_ID>_ACCOUNT_ID=
# GEOCODE_<PROVIDER_ID>_CONTACT_EMAIL=
# GEOCODE_<PROVIDER_ID>_API_KEY=
# GEOCODE_<PROVIDER_ID>_ACCESS_TOKEN=
# GEOCODE_<PROVIDER_ID>_USER_AGENT=
# GEOCODE_<PROVIDER_ID>_BASE_URL=
# GEOCODE_<PROVIDER_ID>_TIMEOUT_SECONDS=10

# No-account/public or self-hosted providers. Disabled by default to avoid silent network calls.
GEOCODE_NOMINATIM_OSM_ENABLED=false
GEOCODE_NOMINATIM_OSM_ACCOUNT_USERNAME=
GEOCODE_NOMINATIM_OSM_ACCOUNT_ID=
GEOCODE_NOMINATIM_OSM_CONTACT_EMAIL=
GEOCODE_NOMINATIM_OSM_USER_AGENT=PF_login PhotoFrame geocoder; contact: configure-GEOCODE_NOMINATIM_OSM_CONTACT_EMAIL
GEOCODE_NOMINATIM_OSM_BASE_URL=https://nominatim.openstreetmap.org/reverse
GEOCODE_NOMINATIM_OSM_TIMEOUT_SECONDS=10

GEOCODE_PHOTON_KOMOOT_ENABLED=false
GEOCODE_PHOTON_KOMOOT_ACCOUNT_USERNAME=
GEOCODE_PHOTON_KOMOOT_ACCOUNT_ID=
GEOCODE_PHOTON_KOMOOT_CONTACT_EMAIL=
GEOCODE_PHOTON_KOMOOT_BASE_URL=https://photon.komoot.io/reverse
GEOCODE_PHOTON_KOMOOT_TIMEOUT_SECONDS=10

GEOCODE_POSTCODES_IO_UK_ENABLED=false
GEOCODE_POSTCODES_IO_UK_ACCOUNT_USERNAME=
GEOCODE_POSTCODES_IO_UK_ACCOUNT_ID=
GEOCODE_POSTCODES_IO_UK_CONTACT_EMAIL=
GEOCODE_POSTCODES_IO_UK_BASE_URL=https://api.postcodes.io/postcodes
GEOCODE_POSTCODES_IO_UK_TIMEOUT_SECONDS=10

GEOCODE_PELIAS_SELF_HOSTED_ENABLED=false
GEOCODE_PELIAS_SELF_HOSTED_ACCOUNT_USERNAME=
GEOCODE_PELIAS_SELF_HOSTED_ACCOUNT_ID=
GEOCODE_PELIAS_SELF_HOSTED_CONTACT_EMAIL=
GEOCODE_PELIAS_SELF_HOSTED_BASE_URL=
GEOCODE_PELIAS_SELF_HOSTED_TIMEOUT_SECONDS=10

# Account/API-key providers. Disabled by default; fill the standardized account fields before enabling.
GEOCODE_OPENCAGE_ENABLED=false
GEOCODE_OPENCAGE_ACCOUNT_USERNAME=
GEOCODE_OPENCAGE_ACCOUNT_ID=
GEOCODE_OPENCAGE_CONTACT_EMAIL=
GEOCODE_OPENCAGE_API_KEY=
GEOCODE_OPENCAGE_BASE_URL=https://api.opencagedata.com/geocode/v1/json
GEOCODE_OPENCAGE_TIMEOUT_SECONDS=10

GEOCODE_GEOAPIFY_ENABLED=false
GEOCODE_GEOAPIFY_ACCOUNT_USERNAME=
GEOCODE_GEOAPIFY_ACCOUNT_ID=
GEOCODE_GEOAPIFY_CONTACT_EMAIL=
GEOCODE_GEOAPIFY_API_KEY=
GEOCODE_GEOAPIFY_BASE_URL=https://api.geoapify.com/v1/geocode/reverse
GEOCODE_GEOAPIFY_TIMEOUT_SECONDS=10

GEOCODE_MAPBOX_ENABLED=false
GEOCODE_MAPBOX_ACCOUNT_USERNAME=
GEOCODE_MAPBOX_ACCOUNT_ID=
GEOCODE_MAPBOX_CONTACT_EMAIL=
GEOCODE_MAPBOX_ACCESS_TOKEN=
GEOCODE_MAPBOX_BASE_URL=https://api.mapbox.com/search/geocode/v6/reverse
GEOCODE_MAPBOX_TIMEOUT_SECONDS=10

GEOCODE_GOOGLE_GEOCODING_ENABLED=false
GEOCODE_GOOGLE_GEOCODING_ACCOUNT_USERNAME=
GEOCODE_GOOGLE_GEOCODING_ACCOUNT_ID=
GEOCODE_GOOGLE_GEOCODING_CONTACT_EMAIL=
GEOCODE_GOOGLE_GEOCODING_API_KEY=
GEOCODE_GOOGLE_GEOCODING_BASE_URL=https://maps.googleapis.com/maps/api/geocode/json
GEOCODE_GOOGLE_GEOCODING_TIMEOUT_SECONDS=10
